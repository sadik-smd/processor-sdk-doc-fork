digraph distro_compatibility_matrix {
    rankdir=LR;
    graph [splines=ortho, nodesep=0.4, ranksep=1.0,
           fontname="Arial", pad=0.6, bgcolor="white"];
    node  [fontname="Arial", fontsize=7, margin=0];
    edge  [fontname="Arial", fontsize=9, penwidth=1.5, arrowsize=0.8];

    subgraph cluster_outer {
        label="TI Processor SDK — Distribution Compatibility Matrix";
        style="filled,bold";
        fillcolor="#F5F5F5";
        color="#1A237E";
        penwidth=4;
        fontsize=18;
        fontcolor="#1A237E";
        fontname="Arial Bold";

        // ── Legend ──────────────────────────────────────────────────
        legend [
            shape=none,
            label=<
              <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="3"
                     CELLPADDING="5" BGCOLOR="#FAFAFA"
                     COLOR="#424242" STYLE="ROUNDED">
                <TR>
                  <TD COLSPAN="3" BGCOLOR="#37474F"
                      STYLE="ROUNDED" WIDTH="280">
                    <FONT COLOR="white" POINT-SIZE="11">
                      <B>Legend — Distributions</B>
                    </FONT>
                  </TD>
                </TR>
                <TR>
                  <TD BGCOLOR="#1565C0" STYLE="ROUNDED" WIDTH="16" HEIGHT="16">
                    <FONT COLOR="white" POINT-SIZE="4"> </FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#1565C0" POINT-SIZE="10"><B>Yocto Linux</B></FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#616161" POINT-SIZE="9">TI reference distro</FONT>
                  </TD>
                </TR>
                <TR>
                  <TD BGCOLOR="#AD1457" STYLE="ROUNDED" WIDTH="16" HEIGHT="16">
                    <FONT COLOR="white" POINT-SIZE="4"> </FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#AD1457" POINT-SIZE="10"><B>Android</B></FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#616161" POINT-SIZE="9">AOSP-based builds</FONT>
                  </TD>
                </TR>
                <TR>
                  <TD BGCOLOR="#2E7D32" STYLE="ROUNDED" WIDTH="16" HEIGHT="16">
                    <FONT COLOR="white" POINT-SIZE="4"> </FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#2E7D32" POINT-SIZE="10"><B>Debian</B></FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#616161" POINT-SIZE="9">Armbian / Debian</FONT>
                  </TD>
                </TR>
                <TR>
                  <TD BGCOLOR="#E65100" STYLE="ROUNDED" WIDTH="16" HEIGHT="16">
                    <FONT COLOR="white" POINT-SIZE="4"> </FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#E65100" POINT-SIZE="10"><B>Buildroot</B></FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#616161" POINT-SIZE="9">Minimal embedded FS</FONT>
                  </TD>
                </TR>
                <TR>
                  <TD BGCOLOR="#6A1B9A" STYLE="ROUNDED" WIDTH="16" HEIGHT="16">
                    <FONT COLOR="white" POINT-SIZE="4"> </FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#6A1B9A" POINT-SIZE="10"><B>EdgeAI</B></FONT>
                  </TD>
                  <TD ALIGN="LEFT" WIDTH="120">
                    <FONT COLOR="#616161" POINT-SIZE="9">AI/ML inference SDK</FONT>
                  </TD>
                </TR>
              </TABLE>
            >
        ];

        // ── Distro header nodes ──────────────────────────────────────
        hdr_linux [
            shape=none,
            label=<
              <TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0"
                     CELLPADDING="8" BGCOLOR="#1565C0"
                     COLOR="#0D47A1" STYLE="ROUNDED">
                <TR>
                  <TD WIDTH="100">
                    <FONT COLOR="white" POINT-SIZE="12"><B>Yocto Linux</B></FONT>
                  </TD>
                </TR>
              </TABLE>
            >
        ];

        hdr_android [
            shape=none,
            label=<
              <TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0"
                     CELLPADDING="8" BGCOLOR="#AD1457"
                     COLOR="#880E4F" STYLE="ROUNDED">
                <TR>
                  <TD WIDTH="100">
                    <FONT COLOR="white" POINT-SIZE="12"><B>Android</B></FONT>
                  </TD>
                </TR>
              </TABLE>
            >
        ];

        hdr_debian [
            shape=none,
            label=<
              <TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0"
                     CELLPADDING="8" BGCOLOR="#2E7D32"
                     COLOR="#1B5E20" STYLE="ROUNDED">
                <TR>
